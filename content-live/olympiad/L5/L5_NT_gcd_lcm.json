      "legacy_id": "OMM-L6-NT-GCDLCM-01",
      "stem": "Find the greatest number that divides $22176$ and $22396$ leaving no remainder.",
      "choices": [],
      "interaction_mode": "integer",
      "hint": {
        "level_0": "A common divisor of both numbers also divides their difference.",
        "level_1": "Compute $\\gcd(22176,22396)=\\gcd(22176,\\,22396-22176)$."
      },
      "solution_steps": [
        "$\\gcd(22176,22396)=\\gcd(22176,\\,220)$.",
        "$22176=220\\cdot100+176$, continue the Euclidean algorithm.",
        "The gcd is $44$ (note $44$ is not among the listed options, so the answer is 'None of these')."
