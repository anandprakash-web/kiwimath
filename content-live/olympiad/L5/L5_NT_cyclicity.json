      "legacy_id": "OMM-L6-NT-CYC-01",
      "stem": "Find the last digit of $2023^{2023}$.",
      "choices": [],
      "interaction_mode": "integer",
      "hint": {
        "level_0": "Units digits (and last-two-digits) repeat in a short cycle.",
        "level_1": "Reduce the exponent modulo the cycle length, then read off the power."
      },
      "solution_steps": [
        "$2023\\equiv 3\\pmod{10}$; units digit of $3^n$ cycles with length $4$.",
        "$2023\\equiv 3\\pmod 4$, so $3^{2023}$ ends like $3^3=27$.",
        "Last digit $=7$."
